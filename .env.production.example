# Backend and worker. Configure these as secrets on the hosting platform.
HOWLIX_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
HOWLIX_DATABASE_SCHEMA=howlix
HOWLIX_ENVIRONMENT=production
HOWLIX_PUBLIC_APP_URL=https://howlix.wolvesgang.digital
HOWLIX_CORS_ORIGINS=https://howlix.wolvesgang.digital
HOWLIX_ALLOWED_HOSTS=api.howlix.wolvesgang.digital

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_howlix_bucket_scoped_access_key_id
R2_SECRET_ACCESS_KEY=your_howlix_bucket_scoped_secret_access_key
R2_BUCKET_NAME=howlix-media
R2_ENDPOINT_URL=
R2_REGION=auto

MAX_UPLOAD_SIZE_MB=1024
MAX_VIDEO_DURATION_SECONDS=1800
MAX_CONCURRENT_JOBS=1
UPLOAD_PART_SIZE_MB=16
UPLOAD_PARALLEL_PARTS=2
SIGNED_URL_EXPIRY_SECONDS=900
UPLOAD_SESSION_EXPIRY_HOURS=24
MAX_PROJECT_STORAGE_MB=10240
UPLOAD_INIT_RATE_LIMIT_PER_MINUTE=10
UPLOAD_SIGN_RATE_LIMIT_PER_MINUTE=120

FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=60
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=300
PROCESSING_TEMP_DIR=
DELETE_INVALID_MEDIA=true
RUN_R2_INTEGRATION_TESTS=false

# Frontend build-time public value. This is not a secret.
NEXT_PUBLIC_API_URL=https://api.howlix.wolvesgang.digital
