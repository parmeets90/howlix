# Backend only. Copy the Session pooler URI from Supabase's Connect dialog,
# replace the password, keep sslmode=require, and never expose this in frontend code.
HOWLIX_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Keep Howlix isolated when sharing a Supabase project with another application.
HOWLIX_DATABASE_SCHEMA=howlix
HOWLIX_ENVIRONMENT=development
HOWLIX_PUBLIC_APP_URL=http://localhost:3000
HOWLIX_CORS_ORIGINS=http://localhost:3000,https://howlix.wolvesgang.digital
HOWLIX_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api.howlix.wolvesgang.digital

# Cloudflare R2 (backend and worker only; never use NEXT_PUBLIC_ names)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_scoped_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_scoped_r2_secret_access_key
R2_BUCKET_NAME=howlix-media
# Optional. When blank, the backend derives https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_REGION=auto

# Upload, quota, and signing policy
MAX_UPLOAD_SIZE_MB=1024
MAX_VIDEO_DURATION_SECONDS=1800
MAX_CONCURRENT_JOBS=1
UPLOAD_PART_SIZE_MB=16
UPLOAD_PARALLEL_PARTS=2
SIGNED_URL_EXPIRY_SECONDS=900
UPLOAD_SESSION_EXPIRY_HOURS=24
MAX_PROJECT_STORAGE_MB=10240
UPLOAD_INIT_RATE_LIMIT_PER_MINUTE=10
UPLOAD_SIGN_RATE_LIMIT_PER_MINUTE=120

# Local FFprobe worker
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
FFPROBE_TIMEOUT_SECONDS=60
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=300
PROCESSING_TEMP_DIR=
DELETE_INVALID_MEDIA=true

# Transcription (backend and worker only)
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional CPU-only fallback; install backend/requirements-local-transcription.txt first.
FASTER_WHISPER_MODEL=base
TRANSCRIPTION_CHUNK_SECONDS=600
TRANSCRIPTION_CHUNK_OVERLAP_SECONDS=1
TRANSCRIPTION_MAX_CHUNK_MB=24
TRANSCRIPTION_SUBPROCESS_TIMEOUT_SECONDS=300
TRANSCRIPTION_API_MAX_RETRIES=3
TRANSCRIPTION_RETRY_BASE_SECONDS=5

# Transcript-only moment discovery (backend and worker only)
MOMENT_ANALYSIS_PROVIDER=groq
GROQ_MOMENT_MODEL=openai/gpt-oss-20b
MOMENT_MIN_DURATION_SECONDS=20
MOMENT_MAX_DURATION_SECONDS=90
MOMENT_TARGET_DURATION_SECONDS=55
MOMENT_MAX_CANDIDATES=24
MOMENT_MAX_RECOMMENDATIONS=10
MOMENT_MIN_EDITORIAL_SCORE=55
MOMENT_MAX_INPUT_CHARS=80000
MOMENT_BATCH_SIZE=12
MOMENT_MAX_API_REQUESTS=3
MOMENT_MAX_OUTPUT_TOKENS=6000
MOMENT_API_MAX_RETRIES=3
MOMENT_RETRY_BASE_SECONDS=5
MOMENT_ANALYSIS_VERSION=1.0
MOMENT_PROMPT_VERSION=m4-v1

# Real cloud tests remain off unless explicitly enabled.
RUN_R2_INTEGRATION_TESTS=false
RUN_GROQ_INTEGRATION_TESTS=false
RUN_MOMENT_GROQ_INTEGRATION_TESTS=false
GROQ_INTEGRATION_AUDIO_PATH=

# Frontend (public by design; do not place secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_URL=http://localhost:8000

