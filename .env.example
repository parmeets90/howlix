# Backend only. Copy the Session pooler URI from Supabase's Connect dialog,
# replace the password, keep sslmode=require, and never expose this in frontend code.
HOWLIX_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
HOWLIX_CORS_ORIGINS=http://localhost:3000

# Cloudflare R2 (backend and worker only; never use NEXT_PUBLIC_ names)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_scoped_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_scoped_r2_secret_access_key
R2_BUCKET_NAME=howlix-media
# Optional. When blank, the backend derives https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_REGION=auto

# Upload, quota, and signing policy
MAX_UPLOAD_SIZE_MB=1024
MAX_VIDEO_DURATION_SECONDS=1800
MAX_CONCURRENT_JOBS=1
UPLOAD_PART_SIZE_MB=16
UPLOAD_PARALLEL_PARTS=2
SIGNED_URL_EXPIRY_SECONDS=900
UPLOAD_SESSION_EXPIRY_HOURS=24
MAX_PROJECT_STORAGE_MB=10240
UPLOAD_INIT_RATE_LIMIT_PER_MINUTE=10
UPLOAD_SIGN_RATE_LIMIT_PER_MINUTE=120

# Local FFprobe worker
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=60
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=300
PROCESSING_TEMP_DIR=
DELETE_INVALID_MEDIA=true

# Real cloud tests remain off unless explicitly enabled.
RUN_R2_INTEGRATION_TESTS=false

# Frontend (public by design; do not place secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_URL=http://localhost:8000

